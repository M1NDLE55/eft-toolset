// The apex redirect: eft-toolset.com to www. Deploy with
// `npx wrangler deploy --config workers/apex-redirect/wrangler.jsonc`.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "eft-toolset-apex",
  "main": "index.ts",
  "compatibility_date": "2026-11-17",
  "routes": [{ "pattern": "eft-toolset.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true }
}
