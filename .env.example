# Every variable is optional. Copy to .env.local for local development; never commit real values.

# The header your proxy sets with the real client IP. On Vercel, X-Real-IP is used automatically.
CLIENT_IP_HEADER=
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
WARM_TARKOV_CACHE=

# Optional sign-in for the MCP endpoint (WorkOS AuthKit). Leave MCP_AUTHKIT_DOMAIN empty to keep
# the endpoint anonymous-only, exactly as without these settings.
# Your AuthKit domain, such as your-app.authkit.app, or its custom domain.
MCP_AUTHKIT_DOMAIN=
# The MCP endpoint's public URL, which must also be a Resource Indicator in WorkOS.
# Defaults to https://www.eft-toolset.com/api/mcp.
MCP_RESOURCE_URL=

# MCP rate limits, as token buckets (tool calls cost 1 to 3 tokens, other requests 0.25).
# Anonymous callers are limited per IP (default 120 burst, 2 per second); signed-in users per
# user (default 160 burst, 3 per second). Keep both below the instance's global MCP budget
# (240 burst, 4 per second), or one caller can use all of it.
MCP_ANON_RATE_BURST=
MCP_ANON_RATE_PER_SECOND=
MCP_USER_RATE_BURST=
MCP_USER_RATE_PER_SECOND=

# Upstash Redis REST settings, so MCP rate limits hold across serverless instances. Without
# them each instance counts in memory. KV_REST_API_URL and KV_REST_API_TOKEN are read too.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
