# Every variable is optional. Copy to .env.local for local development; never commit real values.

# The header your proxy sets with the real client IP. On Vercel, X-Real-IP is used automatically.
CLIENT_IP_HEADER=
CLOUDFLARE_WEB_ANALYTICS_TOKEN=
WARM_TARKOV_CACHE=

# AuthKit domain for optional MCP sign-in, such as your-app.authkit.app; empty disables sign-in.
MCP_AUTHKIT_DOMAIN=
# Public MCP URL registered as a WorkOS Resource Indicator (default https://www.eft-toolset.com/api/mcp).
MCP_RESOURCE_URL=

# Per-IP (anonymous) and per-user MCP token buckets; keep below the global budget (240 burst, 4/s).
MCP_ANON_RATE_BURST=
MCP_ANON_RATE_PER_SECOND=
MCP_USER_RATE_BURST=
MCP_USER_RATE_PER_SECOND=

# Shared MCP rate limits across instances (else in memory); KV_REST_API_* aliases also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
